# Rafta ayarları. Kopyala: cp .env.example .env   (.env asla commit edilmez)

# Şifreleri koruyan 32 baytlık anahtar (base64). Üretmek için:
#   openssl rand -base64 32
# Boş bırakılırsa ilk açılışta data/secret.key dosyası üretilir.
# KAYBEDERSEN KAYITLI ŞİFRELER GERİ GELMEZ: veritabanı yedeğinden ayrı bir yerde sakla.
RAFTA_SECRET_KEY=

# Authenticator koduyla girildikten sonra bir cihaz kaç gün açık kalsın (1–365)
RAFTA_SESSION_DAYS=30

# Saat dilimi (tarih ve geçmiş kayıtları için)
TZ=Europe/Istanbul

# --- Ağ (docker compose) ---
# 127.0.0.1: yalnızca bu makine. 0.0.0.0: yerel ağdaki diğer cihazlar da erişir.
RAFTA_BIND=127.0.0.1
RAFTA_PORT=8080
# Yeniden başlatma: unless-stopped (varsayılan) ya da always
# RAFTA_RESTART=unless-stopped

# --- İmaj adı (registry kullanıyorsan, örn. registry.example.com/rafta) ---
# RAFTA_IMAGE=rafta
# RAFTA_TAG=latest
