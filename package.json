{
  "name": "rafta",
  "version": "0.2.0",
  "description": "Kendi barındırdığın sunucu envanteri ve şifre kasası; şifresiz, authenticator koduyla giriş",
  "license": "MIT",
  "homepage": "https://github.com/sedat-eyuboglu/rafta#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sedat-eyuboglu/rafta.git"
  },
  "keywords": [
    "self-hosted",
    "server-inventory",
    "password-manager",
    "totp",
    "sqlite",
    "hono",
    "htmx"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@hono/node-server": "^2.1.4",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13",
    "htmx.org": "^2.0.11",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
